<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Airbnb-clone</title>
</head>
<body>
    <form method="POST" action="/listings">
        <input name="listing[title]" placeholder="Enter title">
        <br><br>
        <textarea name="listing[description]" placeholder="description" rows="6" cols="10"></textarea>
        <br><br>
        <input name="listing[image]" placeholder="Enter URL/link">
        <br><br>
        <input name="listing[price]" placeholder="Enter price">
        <br><br>
        <input name="listing[location]" placeholder="Enterlocation">
        <br><br>
        <input name="listing[country]" placeholder="Enter country">
        <br><br>
        <button>Add</button>
    </form>
</body>
</html>